---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfilNav from '../../components/profil/ProfilNav.astro';
import { getPath } from '../../utils/links';

const halamanStatis = await getCollection('halaman-statis');
const sejarahEntry = halamanStatis.find((entry) => entry.data.tipe === 'profil-sejarah');

if (!sejarahEntry) {
  throw new Error('Konten halaman sejarah belum tersedia.');
}

const { Content } = await sejarahEntry.render();
---

<BaseLayout
  title="Sejarah Desa Makmurjaya"
  description="Mengenal sejarah dan perjalanan Desa Makmurjaya dari masa ke masa."
>
  <div class="page-header">
    <div class="max-w-7xl mx-auto">
      <p class="eyebrow text-gold-300 mb-1">Tentang Desa</p>
      <h1 class="font-display font-semibold text-2xl md:text-[32px] text-white">Profil Desa Makmurjaya</h1>
      <p class="text-sm text-white/60 mt-1">Kec. Jayakerta, Kab. Karawang, Jawa Barat</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 md:px-8 py-8">
    <ProfilNav currentPath={getPath('/profil/sejarah')} />

    <article class="prose prose-green max-w-none mt-6">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">{sejarahEntry.data.judul}</h2>

      <figure class="my-6">
        <img
          src={getPath('/uploads/hero-desa.png')}
          alt="Foto Desa Makmurjaya"
          class="w-full rounded-2xl object-cover max-h-80"
          width={1200}
          height={600}
          loading="eager"
        />
        <figcaption class="mt-2 text-xs text-muted text-center">Desa Makmurjaya</figcaption>
      </figure>

      <div class="text-ink leading-relaxed">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
