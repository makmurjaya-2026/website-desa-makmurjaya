---
/**
 * Halaman Detail UMKM (Belanja) — menampilkan informasi lengkap usaha berdasarkan slug.
 * Layout: breadcrumb, 2-col grid (image left, info right), description, CTA.
 *
 * Validates: Requirements 7.2, 7.3
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PetaKantor from '../../components/kontak/PetaKantor.astro';
import { getPath } from '../../utils/links';

export async function getStaticPaths() {
  const allUMKM = await getCollection('umkm');

  return allUMKM.map((umkm) => ({
    params: { slug: umkm.slug },
    props: { entry: umkm },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  nama_usaha,
  pemilik,
  kategori,
  jenis_produk,
  harga_range,
  kontak_wa,
  alamat,
  foto_utama,
  galeri_foto,
  lokasi_lat,
  lokasi_lng,
  lokasi_gmaps,
} = entry.data;

// Strip non-numeric characters from WhatsApp number for wa.me link
const kontakWaNumeric = kontak_wa.replace(/\D/g, '');

const breadcrumbItems = [
  { label: 'Beranda', href: getPath('/') },
  { label: 'Belanja', href: getPath('/umkm') },
  { label: nama_usaha },
];
---

<BaseLayout
  title={`${nama_usaha} — UMKM Desa Makmurjaya`}
  description={`${nama_usaha} — ${jenis_produk}. UMKM Desa Makmurjaya.`}
  type="article"
>
  <div class="mx-auto max-w-6xl px-4 md:px-8 py-6">
    {/* Breadcrumb */}
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-1 text-sm text-muted">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center">
            {index > 0 && (
              <svg
                class="mx-1 h-4 w-4 flex-shrink-0 text-muted/50"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            )}
            {item.href ? (
              <a href={item.href} class="hover:text-primary-700 transition-colors">
                {item.label}
              </a>
            ) : (
              <span class="font-medium text-ink" aria-current="page">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    {/* Main 2-col layout */}
    <article data-pagefind-body data-pagefind-meta={`title:${nama_usaha}`}>
      <div class="grid gap-8 lg:grid-cols-2">
        {/* Left: Product image */}
        <div class="overflow-hidden rounded-2xl bg-primary-50">
          {foto_utama ? (
            <img
              src={foto_utama}
              alt={nama_usaha}
              loading="eager"
              class="w-full h-full object-cover aspect-square lg:aspect-[4/3]"
            />
          ) : (
            <div class="flex items-center justify-center h-full min-h-[300px] text-primary-300" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
          )}
        </div>

        {/* Right: Product info */}
        <div class="flex flex-col gap-4">
          {/* Title */}
          <h1 class="font-display text-[26px] font-bold text-ink leading-tight">
            {nama_usaha}
          </h1>

          {/* Pills */}
          <div class="flex flex-wrap gap-2">
            {kategori && <span class="pill">{kategori}</span>}
            {pemilik && <span class="pill-gold">{pemilik}</span>}
          </div>

          {/* Price */}
          {harga_range && (
            <p class="font-display font-bold text-primary-700 text-xl">
              {harga_range}
            </p>
          )}

          {/* Jenis Produk */}
          <div>
            <p class="text-xs text-muted font-medium uppercase tracking-wide mb-1">Jenis Produk</p>
            <p class="sub-text text-ink">{jenis_produk}</p>
          </div>

          {/* Alamat */}
          {alamat && (
            <div>
              <p class="text-xs text-muted font-medium uppercase tracking-wide mb-1">Alamat</p>
              <p class="sub-text text-ink">{alamat}</p>
            </div>
          )}

          {/* Description (Markdown body) */}
          <div class="prose prose-sm max-w-none text-muted leading-relaxed">
            <Content />
          </div>

          {/* CTA Button */}
          <a
            href={`https://wa.me/${kontakWaNumeric}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full text-center mt-2"
            aria-label={`Hubungi ${nama_usaha} via WhatsApp`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Hubungi Penjual
          </a>
        </div>
      </div>

      {/* Galeri produk */}
      {galeri_foto && galeri_foto.length > 0 && (
        <section class="mt-10" aria-labelledby="galeri-heading">
          <h2 id="galeri-heading" class="h-section mb-4">
            Galeri Produk
          </h2>
          <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
            {galeri_foto.map((foto, index) => (
              <figure class="overflow-hidden rounded-xl">
                <img
                  src={foto}
                  alt={`${nama_usaha} - Foto ${index + 1}`}
                  loading="lazy"
                  class="h-full w-full object-cover aspect-square hover:scale-105 transition-transform duration-200"
                />
              </figure>
            ))}
          </div>
        </section>
      )}

      {/* Peta Lokasi */}
      {lokasi_lat && lokasi_lng && (
        <section class="mt-10" aria-labelledby="lokasi-heading">
          <div class="flex items-center justify-between mb-4">
            <h2 id="lokasi-heading" class="h-section">Lokasi Usaha</h2>
            {lokasi_gmaps && (
              <a
                href={lokasi_gmaps}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost text-[13px]"
              >
                Buka di Google Maps
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </a>
            )}
          </div>
          <PetaKantor lat={lokasi_lat} lng={lokasi_lng} label={nama_usaha} zoom={16} />
        </section>
      )}
    </article>
  </div>
</BaseLayout>
