---
/**
 * OrgChart.astro
 * Fixed structure org chart matching the official Desa Makmurjaya bagan exactly.
 * Structure is hardcoded. Names come from content collection.
 */
import { getPath } from '../../utils/links';

interface Perangkat {
  nama: string;
  jabatan: string;
  slug: string;
  foto?: ImageMetadata;
  urutan: number;
  level_hierarki: number;
  parent_slug?: string;
}

interface Props {
  perangkatList: Perangkat[];
}

const { perangkatList } = Astro.props;

function find(slug: string): Perangkat | undefined {
  return perangkatList.find(p => p.slug === slug);
}

const kepalaDesa = find('kepala-desa');
const sekretaris = find('sekretaris-desa');
const kaurKeuangan = find('kaur-keuangan');
const kaurUmum = find('kaur-umum-dan-perencanaan');
const kasiPemerintahan = find('kasi-pemerintahan');
const kasiKesejahteraan = find('kasi-kesejahteraan');
const kasiPelayanan = find('kasi-pelayanan');
const operator = find('operator');
const kadusKarajan = find('kepala-dusun-karajan');
const kadusCibenda = find('kepala-dusun-cibenda');
const penjaga = find('penjaga-kebersihan-desa');
---

{/* === DESKTOP === */}
<div class="hidden md:block overflow-x-auto" role="figure" aria-label="Bagan Struktur Organisasi Pemerintahan Desa Makmurjaya">
  <div class="min-w-[750px] max-w-4xl mx-auto py-6 px-4">

    {/* === ROW 1: BPD + KEPALA DESA === */}
    <div class="flex items-center justify-center gap-4 mb-0">
      <div class="shrink-0 border border-ink/30 rounded-lg px-5 py-2 text-center">
        <span class="font-display font-bold text-sm text-ink">BPD</span>
      </div>
      <div class="w-8 border-t-2 border-ink/20"></div>
      {kepalaDesa && (
        <a href={getPath(`/pemerintahan/${kepalaDesa.slug}`)} class="shrink-0 border-2 border-primary-700 rounded-xl px-6 py-3 text-center bg-white shadow-sm hover:shadow-elevated transition">
          <p class="font-display font-bold text-base text-ink">{kepalaDesa.nama}</p>
          <p class="text-xs text-muted">{kepalaDesa.jabatan}</p>
        </a>
      )}
    </div>

    {/* Vertical line down from Kepala Desa */}
    <div class="flex justify-center">
      <div class="w-0.5 h-10 bg-ink/15"></div>
    </div>

    {/* === ROW 2: SEKRETARIS DESA (right) + branch line to KASI (left) === */}
    {/* This row shows: a horizontal line splitting left (to kasi) and right (to sekretaris) */}
    <div class="relative">
      {/* Horizontal connector bar */}
      <div class="absolute top-0 left-[15%] right-[15%] border-t-2 border-ink/15"></div>

      <div class="grid grid-cols-[1fr_1fr] gap-0 pt-0">
        {/* LEFT: vertical drop to Kasi row */}
        <div class="flex justify-center">
          <div class="w-0.5 h-10 bg-ink/15"></div>
        </div>
        {/* RIGHT: Sekretaris Desa */}
        <div class="flex justify-center">
          <div class="flex flex-col items-center">
            <div class="w-0.5 h-4 bg-ink/15"></div>
            {sekretaris && (
              <a href={getPath(`/pemerintahan/${sekretaris.slug}`)} class="border-2 border-primary-500 rounded-xl px-5 py-2.5 text-center bg-primary-50/60 hover:shadow-card transition">
                <p class="font-display font-semibold text-sm text-ink">{sekretaris.nama}</p>
                <p class="text-[11px] text-muted">{sekretaris.jabatan}</p>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    {/* === ROW 3: KASI (left side) + KAUR (right side under sekretaris) === */}
    <div class="grid grid-cols-[1fr_1fr] gap-6">
      {/* LEFT: 3 Kasi */}
      <div>
        {/* Horizontal connector above kasi */}
        <div class="flex justify-center mb-1">
          <div class="w-[80%] border-t-2 border-ink/15"></div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          {[kasiPemerintahan, kasiKesejahteraan, kasiPelayanan].map((kasi) => kasi && (
            <a href={getPath(`/pemerintahan/${kasi.slug}`)} class="flex flex-col items-center border border-line rounded-lg px-2 py-2.5 text-center bg-white hover:border-primary-300 transition">
              <p class="font-display font-semibold text-xs text-ink leading-tight">{kasi.nama}</p>
              <p class="text-[10px] text-muted leading-tight mt-0.5">{kasi.jabatan}</p>
            </a>
          ))}
        </div>
      </div>

      {/* RIGHT: 2 Kaur (under Sekretaris) */}
      <div>
        <div class="flex justify-center">
          <div class="w-0.5 h-6 bg-ink/15"></div>
        </div>
        <div class="flex justify-center mb-1">
          <div class="w-[70%] border-t-2 border-ink/15"></div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          {[kaurKeuangan, kaurUmum].map((kaur) => kaur && (
            <a href={getPath(`/pemerintahan/${kaur.slug}`)} class="flex flex-col items-center border border-line rounded-lg px-2 py-2.5 text-center bg-white hover:border-primary-300 transition">
              <p class="font-display font-semibold text-xs text-ink leading-tight">{kaur.nama}</p>
              <p class="text-[10px] text-muted leading-tight mt-0.5">{kaur.jabatan}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    {/* === ROW 4: Bottom row (Operator, Kadus, Penjaga) === */}
    <div class="flex justify-center mt-4">
      <div class="w-0.5 h-8 bg-ink/15"></div>
    </div>
    <div class="flex justify-center mb-2">
      <div class="w-[70%] border-t-2 border-ink/15"></div>
    </div>
    <div class="grid grid-cols-4 gap-2 max-w-2xl mx-auto">
      {[operator, kadusKarajan, penjaga, kadusCibenda].map((p) => p && (
        <a href={getPath(`/pemerintahan/${p.slug}`)} class="flex flex-col items-center border border-line rounded-lg px-2 py-2.5 text-center bg-white hover:border-primary-300 transition">
          <p class="font-display font-semibold text-xs text-ink leading-tight">{p.nama}</p>
          <p class="text-[10px] text-muted leading-tight mt-0.5">{p.jabatan}</p>
        </a>
      ))}
    </div>

  </div>
</div>

{/* === MOBILE === */}
<div class="md:hidden space-y-1.5 px-2" role="list" aria-label="Struktur Organisasi Pemerintahan Desa">
  {kepalaDesa && (
    <a href={getPath(`/pemerintahan/${kepalaDesa.slug}`)} class="block border-2 border-primary-700 rounded-xl px-4 py-3 bg-white">
      <p class="font-display font-bold text-[15px] text-ink">{kepalaDesa.nama}</p>
      <p class="text-[11px] text-muted">{kepalaDesa.jabatan}</p>
    </a>
  )}

  {sekretaris && (
    <div class="ml-4 border-l-2 border-primary-400 pl-3">
      <a href={getPath(`/pemerintahan/${sekretaris.slug}`)} class="block border border-primary-300 rounded-lg px-3 py-2 bg-primary-50/60">
        <p class="font-display font-semibold text-[13px] text-ink">{sekretaris.nama}</p>
        <p class="text-[10px] text-muted">{sekretaris.jabatan}</p>
      </a>
      <div class="ml-3 mt-1 space-y-1 border-l-2 border-primary-200 pl-3">
        {[kaurKeuangan, kaurUmum].map((kaur) => kaur && (
          <a href={getPath(`/pemerintahan/${kaur.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
            <p class="font-semibold text-[12px] text-ink">{kaur.nama}</p>
            <p class="text-[10px] text-muted">{kaur.jabatan}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  {kasiPemerintahan && (
    <div class="ml-4 border-l-2 border-primary-400 pl-3">
      <a href={getPath(`/pemerintahan/${kasiPemerintahan.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{kasiPemerintahan.nama}</p>
        <p class="text-[10px] text-muted">{kasiPemerintahan.jabatan}</p>
      </a>
      {operator && (
        <div class="ml-3 mt-1 border-l-2 border-primary-200 pl-3">
          <a href={getPath(`/pemerintahan/${operator.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
            <p class="font-semibold text-[12px] text-ink">{operator.nama}</p>
            <p class="text-[10px] text-muted">{operator.jabatan}</p>
          </a>
        </div>
      )}
    </div>
  )}

  {kasiKesejahteraan && (
    <div class="ml-4 border-l-2 border-primary-400 pl-3">
      <a href={getPath(`/pemerintahan/${kasiKesejahteraan.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{kasiKesejahteraan.nama}</p>
        <p class="text-[10px] text-muted">{kasiKesejahteraan.jabatan}</p>
      </a>
    </div>
  )}

  {kasiPelayanan && (
    <div class="ml-4 border-l-2 border-primary-400 pl-3">
      <a href={getPath(`/pemerintahan/${kasiPelayanan.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{kasiPelayanan.nama}</p>
        <p class="text-[10px] text-muted">{kasiPelayanan.jabatan}</p>
      </a>
    </div>
  )}

  <div class="ml-4 border-l-2 border-primary-400 pl-3">
    <p class="text-[10px] font-semibold text-muted uppercase tracking-wide py-1">Kepala Dusun</p>
    <div class="ml-3 space-y-1 border-l-2 border-primary-200 pl-3">
      {[kadusKarajan, kadusCibenda].map((kadus) => kadus && (
        <a href={getPath(`/pemerintahan/${kadus.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
          <p class="font-semibold text-[12px] text-ink">{kadus.nama}</p>
          <p class="text-[10px] text-muted">{kadus.jabatan}</p>
        </a>
      ))}
    </div>
  </div>

  {penjaga && (
    <div class="ml-4 border-l-2 border-primary-400 pl-3">
      <a href={getPath(`/pemerintahan/${penjaga.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{penjaga.nama}</p>
        <p class="text-[10px] text-muted">{penjaga.jabatan}</p>
      </a>
    </div>
  )}
</div>
