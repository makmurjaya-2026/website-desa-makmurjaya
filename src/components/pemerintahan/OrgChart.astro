---
/**
 * OrgChart.astro
 * Fixed structure org chart matching the official Desa Makmurjaya bagan.
 * Structure is NOT dynamically generated — it is hardcoded to match the
 * real org chart on the wall of the kantor desa.
 *
 * Names are pulled from perangkat-desa content collection.
 * To change names: edit via CMS or markdown files.
 * To change STRUCTURE: edit this component directly.
 */
import { getPath } from '../../utils/links';

interface Perangkat {
  nama: string;
  jabatan: string;
  slug: string;
  foto?: ImageMetadata;
  urutan: number;
  level_hierarki: number;
  parent_slug?: string;
}

interface Props {
  perangkatList: Perangkat[];
}

const { perangkatList } = Astro.props;

// Helper to find person by slug
function find(slug: string): Perangkat | undefined {
  return perangkatList.find(p => p.slug === slug);
}

const kepalaDesa = find('kepala-desa');
const sekretaris = find('sekretaris-desa');
const kaurKeuangan = find('kaur-keuangan');
const kaurUmum = find('kaur-umum-dan-perencanaan');
const kasiPemerintahan = find('kasi-pemerintahan');
const kasiKesejahteraan = find('kasi-kesejahteraan');
const kasiPelayanan = find('kasi-pelayanan');
const operator = find('operator');
const kadusKarajan = find('kepala-dusun-karajan');
const kadusCibenda = find('kepala-dusun-cibenda');
const penjaga = find('penjaga-kebersihan-desa');
---

{/* === DESKTOP VIEW === */}
<div class="hidden md:block" role="figure" aria-label="Bagan Struktur Organisasi Pemerintahan Desa Makmurjaya">

  {/* Row 1: BPD + Kepala Desa */}
  <div class="flex justify-center items-center gap-8 mb-2">
    <div class="border border-line rounded-lg px-4 py-2 text-center bg-white">
      <p class="font-display font-semibold text-sm text-ink">BPD</p>
    </div>
    <div class="w-12 h-px bg-line" aria-hidden="true"></div>
    {kepalaDesa && (
      <a href={getPath(`/pemerintahan/${kepalaDesa.slug}`)} class="block border-2 border-primary-700 rounded-xl px-6 py-3 text-center bg-white hover:shadow-elevated transition">
        <p class="font-display font-bold text-base text-ink">{kepalaDesa.nama}</p>
        <p class="text-xs text-muted">{kepalaDesa.jabatan}</p>
      </a>
    )}
  </div>

  {/* Vertical line from Kepala Desa */}
  <div class="flex justify-center">
    <div class="w-px h-8 bg-line" aria-hidden="true"></div>
  </div>

  {/* Row 2: Sekretaris Desa (right side, connected to Kepala Desa) */}
  <div class="flex justify-center mb-2">
    <div class="grid grid-cols-[1fr_auto_1fr] items-start gap-0 w-full max-w-5xl">
      {/* Left: Kasi group connector */}
      <div class="flex flex-col items-center">
        <div class="w-full h-px bg-line" aria-hidden="true"></div>
      </div>
      {/* Center: vertical connector */}
      <div class="flex flex-col items-center">
        <div class="w-px h-0 bg-line" aria-hidden="true"></div>
      </div>
      {/* Right: Sekretaris */}
      <div class="flex items-start">
        <div class="w-12 h-px bg-line mt-5" aria-hidden="true"></div>
        {sekretaris && (
          <a href={getPath(`/pemerintahan/${sekretaris.slug}`)} class="block border border-primary-600 rounded-xl px-5 py-3 text-center bg-primary-50 hover:shadow-elevated transition">
            <p class="font-display font-semibold text-sm text-ink">{sekretaris.nama}</p>
            <p class="text-[11px] text-muted">{sekretaris.jabatan}</p>
          </a>
        )}
      </div>
    </div>
  </div>

  {/* Vertical line continues */}
  <div class="flex justify-center">
    <div class="w-px h-6 bg-line" aria-hidden="true"></div>
  </div>

  {/* Row 3: Kaur (under Sekretaris) + Kasi (under Kepala Desa) */}
  <div class="flex justify-center mb-2">
    <div class="grid grid-cols-2 gap-8 w-full max-w-5xl">
      {/* Left half: 3 Kasi */}
      <div>
        <div class="flex justify-center mb-2">
          <div class="w-3/4 h-px bg-line" aria-hidden="true"></div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          {kasiPemerintahan && (
            <a href={getPath(`/pemerintahan/${kasiPemerintahan.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
              <p class="font-display font-semibold text-[13px] text-ink">{kasiPemerintahan.nama}</p>
              <p class="text-[10px] text-muted">{kasiPemerintahan.jabatan}</p>
            </a>
          )}
          {kasiKesejahteraan && (
            <a href={getPath(`/pemerintahan/${kasiKesejahteraan.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
              <p class="font-display font-semibold text-[13px] text-ink">{kasiKesejahteraan.nama}</p>
              <p class="text-[10px] text-muted">{kasiKesejahteraan.jabatan}</p>
            </a>
          )}
          {kasiPelayanan && (
            <a href={getPath(`/pemerintahan/${kasiPelayanan.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
              <p class="font-display font-semibold text-[13px] text-ink">{kasiPelayanan.nama}</p>
              <p class="text-[10px] text-muted">{kasiPelayanan.jabatan}</p>
            </a>
          )}
        </div>
      </div>

      {/* Right half: 2 Kaur (under Sekretaris) */}
      <div>
        <div class="flex justify-center mb-2">
          <div class="w-1/2 h-px bg-line" aria-hidden="true"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {kaurKeuangan && (
            <a href={getPath(`/pemerintahan/${kaurKeuangan.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
              <p class="font-display font-semibold text-[13px] text-ink">{kaurKeuangan.nama}</p>
              <p class="text-[10px] text-muted">{kaurKeuangan.jabatan}</p>
            </a>
          )}
          {kaurUmum && (
            <a href={getPath(`/pemerintahan/${kaurUmum.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
              <p class="font-display font-semibold text-[13px] text-ink">{kaurUmum.nama}</p>
              <p class="text-[10px] text-muted">{kaurUmum.jabatan}</p>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  {/* Vertical lines down to bottom row */}
  <div class="flex justify-center">
    <div class="w-full max-w-5xl">
      <div class="flex justify-center">
        <div class="w-px h-8 bg-line" aria-hidden="true"></div>
      </div>
      <div class="w-3/4 mx-auto h-px bg-line" aria-hidden="true"></div>
    </div>
  </div>

  {/* Row 4: Bottom — Operator, Kadus Karajan, Penjaga, Kadus Cibenda */}
  <div class="flex justify-center mt-2">
    <div class="grid grid-cols-4 gap-3 w-full max-w-4xl">
      {operator && (
        <a href={getPath(`/pemerintahan/${operator.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
          <p class="font-display font-semibold text-[13px] text-ink">{operator.nama}</p>
          <p class="text-[10px] text-muted">{operator.jabatan}</p>
        </a>
      )}
      {kadusKarajan && (
        <a href={getPath(`/pemerintahan/${kadusKarajan.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
          <p class="font-display font-semibold text-[13px] text-ink">{kadusKarajan.nama}</p>
          <p class="text-[10px] text-muted">{kadusKarajan.jabatan}</p>
        </a>
      )}
      {penjaga && (
        <a href={getPath(`/pemerintahan/${penjaga.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
          <p class="font-display font-semibold text-[13px] text-ink">{penjaga.nama}</p>
          <p class="text-[10px] text-muted">{penjaga.jabatan}</p>
        </a>
      )}
      {kadusCibenda && (
        <a href={getPath(`/pemerintahan/${kadusCibenda.slug}`)} class="block border border-line rounded-xl px-3 py-3 text-center bg-white hover:shadow-card transition">
          <p class="font-display font-semibold text-[13px] text-ink">{kadusCibenda.nama}</p>
          <p class="text-[10px] text-muted">{kadusCibenda.jabatan}</p>
        </a>
      )}
    </div>
  </div>
</div>

{/* === MOBILE VIEW === */}
<div class="md:hidden space-y-1" role="list" aria-label="Struktur Organisasi Pemerintahan Desa">
  {/* Kepala Desa */}
  {kepalaDesa && (
    <a href={getPath(`/pemerintahan/${kepalaDesa.slug}`)} class="block border-2 border-primary-700 rounded-xl px-4 py-3 bg-white">
      <p class="font-display font-bold text-sm text-ink">{kepalaDesa.nama}</p>
      <p class="text-[11px] text-muted">{kepalaDesa.jabatan}</p>
    </a>
  )}

  {/* Sekretaris */}
  {sekretaris && (
    <div class="pl-4 border-l-2 border-primary-400">
      <a href={getPath(`/pemerintahan/${sekretaris.slug}`)} class="block border border-primary-300 rounded-xl px-4 py-2.5 bg-primary-50">
        <p class="font-display font-semibold text-[13px] text-ink">{sekretaris.nama}</p>
        <p class="text-[10px] text-muted">{sekretaris.jabatan}</p>
      </a>
      {/* Kaur under Sekretaris */}
      <div class="pl-4 mt-1 space-y-1 border-l-2 border-primary-200">
        {kaurKeuangan && (
          <a href={getPath(`/pemerintahan/${kaurKeuangan.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
            <p class="font-semibold text-[12px] text-ink">{kaurKeuangan.nama}</p>
            <p class="text-[10px] text-muted">{kaurKeuangan.jabatan}</p>
          </a>
        )}
        {kaurUmum && (
          <a href={getPath(`/pemerintahan/${kaurUmum.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
            <p class="font-semibold text-[12px] text-ink">{kaurUmum.nama}</p>
            <p class="text-[10px] text-muted">{kaurUmum.jabatan}</p>
          </a>
        )}
      </div>
    </div>
  )}

  {/* Kasi Pemerintahan + Operator */}
  {kasiPemerintahan && (
    <div class="pl-4 border-l-2 border-primary-400">
      <a href={getPath(`/pemerintahan/${kasiPemerintahan.slug}`)} class="block border border-line rounded-xl px-4 py-2.5 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{kasiPemerintahan.nama}</p>
        <p class="text-[10px] text-muted">{kasiPemerintahan.jabatan}</p>
      </a>
      {operator && (
        <div class="pl-4 mt-1 border-l-2 border-primary-200">
          <a href={getPath(`/pemerintahan/${operator.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
            <p class="font-semibold text-[12px] text-ink">{operator.nama}</p>
            <p class="text-[10px] text-muted">{operator.jabatan}</p>
          </a>
        </div>
      )}
    </div>
  )}

  {/* Kasi Kesejahteraan */}
  {kasiKesejahteraan && (
    <div class="pl-4 border-l-2 border-primary-400">
      <a href={getPath(`/pemerintahan/${kasiKesejahteraan.slug}`)} class="block border border-line rounded-xl px-4 py-2.5 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{kasiKesejahteraan.nama}</p>
        <p class="text-[10px] text-muted">{kasiKesejahteraan.jabatan}</p>
      </a>
    </div>
  )}

  {/* Kasi Pelayanan */}
  {kasiPelayanan && (
    <div class="pl-4 border-l-2 border-primary-400">
      <a href={getPath(`/pemerintahan/${kasiPelayanan.slug}`)} class="block border border-line rounded-xl px-4 py-2.5 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{kasiPelayanan.nama}</p>
        <p class="text-[10px] text-muted">{kasiPelayanan.jabatan}</p>
      </a>
    </div>
  )}

  {/* Kepala Dusun */}
  <div class="pl-4 border-l-2 border-primary-400">
    <p class="text-[11px] font-semibold text-muted uppercase tracking-wide py-1">Kepala Dusun</p>
    <div class="pl-4 space-y-1 border-l-2 border-primary-200">
      {kadusKarajan && (
        <a href={getPath(`/pemerintahan/${kadusKarajan.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
          <p class="font-semibold text-[12px] text-ink">{kadusKarajan.nama}</p>
          <p class="text-[10px] text-muted">{kadusKarajan.jabatan}</p>
        </a>
      )}
      {kadusCibenda && (
        <a href={getPath(`/pemerintahan/${kadusCibenda.slug}`)} class="block border border-line rounded-lg px-3 py-2 bg-white">
          <p class="font-semibold text-[12px] text-ink">{kadusCibenda.nama}</p>
          <p class="text-[10px] text-muted">{kadusCibenda.jabatan}</p>
        </a>
      )}
    </div>
  </div>

  {/* Penjaga */}
  {penjaga && (
    <div class="pl-4 border-l-2 border-primary-400">
      <a href={getPath(`/pemerintahan/${penjaga.slug}`)} class="block border border-line rounded-xl px-4 py-2.5 bg-white">
        <p class="font-display font-semibold text-[13px] text-ink">{penjaga.nama}</p>
        <p class="text-[10px] text-muted">{penjaga.jabatan}</p>
      </a>
    </div>
  )}
</div>
