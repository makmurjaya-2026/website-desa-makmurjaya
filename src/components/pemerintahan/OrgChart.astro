---
/**
 * OrgChart.astro
 * Menampilkan bagan struktur organisasi pemerintahan desa.
 * Renders a proper tree layout based on parent_slug relationships.
 *
 * Structure is FIXED to match the official village org chart:
 * - BPD sits alongside Kepala Desa (advisory)
 * - Sekretaris Desa → Kaur Keuangan, Kaur Umum dan Perencanaan
 * - Kasi Pemerintahan → Operator
 * - Kasi Kesejahteraan (no children)
 * - Kasi Pelayanan (no children)
 * - Kepala Dusun: Kadus Karajan, Kadus Cibenda
 * - Penjaga dan Petugas Kebersihan Desa
 */

import PerangkatCard from './PerangkatCard.astro';

interface Perangkat {
  nama: string;
  jabatan: string;
  slug: string;
  foto?: ImageMetadata;
  urutan: number;
  level_hierarki: number;
  parent_slug?: string;
}

interface Props {
  perangkatList: Perangkat[];
}

const { perangkatList } = Astro.props;

// Build tree from parent_slug relationships
interface TreeNode extends Perangkat {
  children: TreeNode[];
}

function buildTree(items: Perangkat[]): TreeNode[] {
  const nodeMap = new Map<string, TreeNode>();
  const roots: TreeNode[] = [];

  for (const item of items) {
    nodeMap.set(item.slug, { ...item, children: [] });
  }

  for (const item of items) {
    const node = nodeMap.get(item.slug)!;
    if (item.parent_slug && nodeMap.has(item.parent_slug)) {
      nodeMap.get(item.parent_slug)!.children.push(node);
    } else {
      roots.push(node);
    }
  }

  for (const node of nodeMap.values()) {
    node.children.sort((a, b) => a.urutan - b.urutan);
  }

  return roots.sort((a, b) => a.urutan - b.urutan);
}

// Flatten for mobile
interface FlatItem extends Perangkat {
  depth: number;
}

function flattenTree(nodes: TreeNode[], depth: number = 0): FlatItem[] {
  const result: FlatItem[] = [];
  for (const node of nodes) {
    result.push({ ...node, depth });
    result.push(...flattenTree(node.children, depth + 1));
  }
  return result;
}

const tree = buildTree(perangkatList);
const flatList = flattenTree(tree);

// Find Kepala Desa (root)
const kepalaDesa = tree.find(n => n.level_hierarki === 1);
const directChildren = kepalaDesa?.children || [];

// Group direct children
const sekretaris = directChildren.find(c => c.slug === 'sekretaris-desa');
const kasiList = directChildren.filter(c => c.jabatan.startsWith('Kasi'));
const kadusAndOthers = directChildren.filter(c =>
  !c.jabatan.startsWith('Kasi') && c.slug !== 'sekretaris-desa'
);
---

{/* Desktop: Proper hierarchical tree layout */}
<div class="hidden md:block" role="figure" aria-label="Bagan Struktur Organisasi Pemerintahan Desa">
  <div class="flex flex-col items-center gap-0">

    {/* Level 1: Kepala Desa */}
    {kepalaDesa && (
      <div class="flex flex-col items-center">
        <div class="max-w-xs w-full">
          <PerangkatCard
            nama={kepalaDesa.nama}
            jabatan={kepalaDesa.jabatan}
            slug={kepalaDesa.slug}
            foto={kepalaDesa.foto}
          />
        </div>

        {/* Vertical connector */}
        <div class="w-px h-8 bg-line" aria-hidden="true"></div>

        {/* Horizontal connector spanning all branches */}
        <div class="w-full max-w-4xl h-px bg-line" aria-hidden="true"></div>
      </div>
    )}

    {/* Level 2: Sekretaris + Kasi row */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 w-full max-w-4xl">
      {/* Sekretaris Desa branch */}
      {sekretaris && (
        <div class="flex flex-col items-center">
          <div class="w-px h-6 bg-line" aria-hidden="true"></div>
          <PerangkatCard
            nama={sekretaris.nama}
            jabatan={sekretaris.jabatan}
            slug={sekretaris.slug}
            foto={sekretaris.foto}
          />
          {/* Sekretaris children (Kaur) */}
          {sekretaris.children.length > 0 && (
            <div class="flex flex-col items-center w-full mt-1">
              <div class="w-px h-4 bg-line" aria-hidden="true"></div>
              <div class="space-y-2 w-full">
                {sekretaris.children.map((kaur) => (
                  <div class="flex flex-col items-center">
                    <PerangkatCard
                      nama={kaur.nama}
                      jabatan={kaur.jabatan}
                      slug={kaur.slug}
                      foto={kaur.foto}
                    />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {/* Kasi branches */}
      {kasiList.map((kasi) => (
        <div class="flex flex-col items-center">
          <div class="w-px h-6 bg-line" aria-hidden="true"></div>
          <PerangkatCard
            nama={kasi.nama}
            jabatan={kasi.jabatan}
            slug={kasi.slug}
            foto={kasi.foto}
          />
          {/* Kasi children (e.g. Operator under Kasi Pemerintahan) */}
          {kasi.children.length > 0 && (
            <div class="flex flex-col items-center w-full mt-1">
              <div class="w-px h-4 bg-line" aria-hidden="true"></div>
              <div class="space-y-2 w-full">
                {kasi.children.map((child) => (
                  <div class="flex flex-col items-center">
                    <PerangkatCard
                      nama={child.nama}
                      jabatan={child.jabatan}
                      slug={child.slug}
                      foto={child.foto}
                    />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    {/* Level 3: Kadus and other staff */}
    {kadusAndOthers.length > 0 && (
      <div class="flex flex-col items-center w-full max-w-4xl mt-2">
        <div class="w-px h-6 bg-line" aria-hidden="true"></div>
        <div class="w-full max-w-2xl h-px bg-line" aria-hidden="true"></div>
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 w-full max-w-3xl mt-2">
          {kadusAndOthers.map((member) => (
            <div class="flex flex-col items-center">
              <PerangkatCard
                nama={member.nama}
                jabatan={member.jabatan}
                slug={member.slug}
                foto={member.foto}
              />
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

{/* Mobile: Vertical tree with indentation */}
<ul class="md:hidden space-y-1" role="list" aria-label="Daftar Struktur Organisasi Pemerintahan Desa">
  {flatList.map((item) => (
    <li
      role="listitem"
      style={`padding-left: ${item.depth * 1.25}rem;`}
      class:list={[
        'border-l-2',
        item.depth === 0 ? 'border-primary-700' : item.depth === 1 ? 'border-primary-400' : 'border-primary-200',
      ]}
    >
      <PerangkatCard
        nama={item.nama}
        jabatan={item.jabatan}
        slug={item.slug}
        foto={item.foto}
      />
    </li>
  ))}
</ul>
