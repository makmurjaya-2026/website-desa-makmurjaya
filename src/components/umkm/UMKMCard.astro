---
/**
 * UMKMCard.astro
 * Kartu UMKM dengan design system baru — image placeholder, title,
 * category pill + seller pill-gold, price, dan CTA button.
 * Touch target minimal 44x44px untuk aksesibilitas mobile.
 *
 * Validates: Requirements 7.1
 */
import { getPath } from '../../utils/links';

interface Props {
  nama_usaha: string;
  slug: string;
  kategori?: string;
  pemilik?: string;
  harga_range?: string;
  kontak_wa?: string;
  foto_utama?: string;
}

const { nama_usaha, slug, kategori, pemilik, harga_range, kontak_wa, foto_utama } = Astro.props;
const kontakWaNumeric = kontak_wa ? kontak_wa.replace(/\D/g, '') : '';
---

<article class="card flex flex-col" data-kategori={kategori || ''}>
  {/* Image area */}
  <div class="aspect-[4/3] w-full overflow-hidden bg-primary-50">
    {foto_utama ? (
      <img
        src={foto_utama}
        alt={nama_usaha}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-200 hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-primary-300" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
    )}
  </div>

  {/* Content */}
  <div class="flex flex-col flex-1 p-4 sm:p-5 gap-3">
    {/* Title */}
    <h3 class="font-display font-semibold text-ink text-base leading-snug line-clamp-2">
      <a
        href={getPath(`/umkm/${slug}`)}
        class="hover:text-primary-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 rounded"
        aria-label={`Lihat UMKM: ${nama_usaha}`}
      >
        {nama_usaha}
      </a>
    </h3>

    {/* Pills */}
    <div class="flex flex-wrap gap-2">
      {kategori && <span class="pill">{kategori}</span>}
      {pemilik && <span class="pill-gold">{pemilik}</span>}
    </div>

    {/* Price */}
    {harga_range && (
      <p class="font-display font-semibold text-primary-700 text-base mt-auto">
        {harga_range}
      </p>
    )}

    {/* CTA */}
    {kontak_wa ? (
      <a
        href={`https://wa.me/${kontakWaNumeric}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline w-full text-center mt-1"
        aria-label={`Hubungi ${nama_usaha} via WhatsApp`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hubungi Penjual
      </a>
    ) : (
      <a
        href={getPath(`/umkm/${slug}`)}
        class="btn-outline w-full text-center mt-1"
      >
        Lihat Detail
      </a>
    )}
  </div>
</article>
