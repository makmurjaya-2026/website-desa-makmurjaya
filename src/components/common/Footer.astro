---
/**
 * Footer.astro
 * Dark green footer matching Figma hi-fi mockup.
 * Reads site settings from src/data/situs.json for editable content.
 *
 * Requirements: 1.7, 12.4
 */
import { getPath } from '../../utils/links';
import situs from '../../data/situs.json';
---

<footer class="bg-primary-800 text-white" data-pagefind-ignore>
  <!-- Desktop Footer -->
  <div class="hidden md:block px-8 py-10">
    <div class="max-w-7xl mx-auto grid grid-cols-5 gap-8 mb-8">
      <!-- Brand column -->
      <div class="col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-primary-700 flex items-center justify-center shrink-0 overflow-hidden">
            <img src={`${import.meta.env.BASE_URL}uploads/Logo-desa.png`} alt="Logo Desa Makmurjaya" class="w-full h-full object-contain p-0.5" />
          </div>
          <div>
            <div class="font-display font-semibold text-[15px] text-white">{situs.nama_desa}</div>
            <div class="text-[11px] text-white/50">{situs.lokasi_singkat}</div>
          </div>
        </div>
        <p class="text-[12px] text-white/60 leading-relaxed max-w-xs">{situs.deskripsi_footer}</p>
      </div>

      <!-- Hubungi Kami -->
      <div>
        <div class="font-display font-semibold text-[14px] text-white mb-3">Hubungi Kami</div>
        <div class="space-y-1">
          <div class="text-[12px] text-white/70 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            {situs.alamat}
          </div>
          <div class="text-[12px] text-white/70 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {situs.jam_layanan}
          </div>
        </div>
      </div>

      <!-- Navigasi -->
      <div>
        <div class="font-display font-semibold text-[14px] text-white mb-3">Navigasi</div>
        <div class="space-y-1">
          <a href={getPath('/')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Beranda</a>
          <a href={getPath('/profil/sejarah')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Profil Desa</a>
          <a href={getPath('/infografis')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Infografis</a>
          <a href={getPath('/berita')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Berita</a>
          <a href={getPath('/umkm')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Belanja</a>
        </div>
      </div>

      <!-- Jelajahi -->
      <div>
        <div class="font-display font-semibold text-[14px] text-white mb-3">Jelajahi</div>
        <div class="space-y-1">
          <a href={getPath('/pemerintahan')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Pemerintahan</a>
          <a href={getPath('/galeri')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Galeri</a>
          <a href={getPath('/faq')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">FAQ</a>
          <a href={getPath('/kontak')} class="block text-[12px] text-white/70 hover:text-white py-0.5 transition">Kontak</a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="max-w-7xl mx-auto border-t border-white/10 pt-6 flex items-center justify-between">
      <div class="text-[11px] text-white/40">{situs.copyright}</div>
      <div class="text-[11px] text-white/40">Dibuat oleh Muhamad Tristan Farand · KKN IPB 2026</div>
    </div>
  </div>

  <!-- Mobile Footer -->
  <div class="md:hidden px-4 py-6">
    <div class="flex items-center gap-2.5 mb-4">
      <div class="w-9 h-9 rounded-xl bg-primary-700 flex items-center justify-center shrink-0 overflow-hidden">
        <img src={`${import.meta.env.BASE_URL}uploads/Logo-desa.png`} alt="Logo Desa Makmurjaya" class="w-full h-full object-contain p-0.5" />
      </div>
      <div>
        <div class="font-display font-semibold text-[13px]">{situs.nama_desa}</div>
        <div class="text-[10.5px] text-white/70">{situs.lokasi_singkat}</div>
      </div>
    </div>

    <!-- Accordion items -->
    <details class="border-b border-white/10">
      <summary class="flex items-center justify-between py-2.5 text-[11.5px] text-white/85 cursor-pointer list-none">
        <span class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Kontak Desa
        </span>
        <svg class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
      </summary>
      <div class="pb-3 pl-6 text-[11px] text-white/60 space-y-1">
        <p>{situs.alamat}</p>
        <p>{situs.jam_layanan}</p>
        {situs.telepon && <p>Tel: {situs.telepon}</p>}
        {situs.email && <p>{situs.email}</p>}
      </div>
    </details>

    <details class="border-b border-white/10">
      <summary class="flex items-center justify-between py-2.5 text-[11.5px] text-white/85 cursor-pointer list-none">
        <span class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          Jelajahi
        </span>
        <svg class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
      </summary>
      <div class="pb-3 pl-6 text-[11px] text-white/60 space-y-1.5">
        <a href={getPath('/profil/sejarah')} class="block hover:text-white transition">Profil Desa</a>
        <a href={getPath('/infografis')} class="block hover:text-white transition">Infografis</a>
        <a href={getPath('/pemerintahan')} class="block hover:text-white transition">Pemerintahan</a>
        <a href={getPath('/berita')} class="block hover:text-white transition">Berita</a>
        <a href={getPath('/umkm')} class="block hover:text-white transition">Belanja</a>
        <a href={getPath('/galeri')} class="block hover:text-white transition">Galeri</a>
      </div>
    </details>

    <!-- Copyright -->
    <div class="mt-6 text-center text-[10px] text-white/40">
      {situs.copyright} · Dibuat oleh Muhamad Tristan Farand · KKN IPB 2026
    </div>
  </div>
</footer>
